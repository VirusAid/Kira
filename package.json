{
  "name": "kira",
  "version": "1.3.4",
  "description": "Kira — персональный ИИ-ассистент нового поколения для Windows",
  "main": "./out/main/index.js",
  "author": "VirusAid (D3F0LT)",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "dist": "node scripts/licenses.mjs && node scripts/prepare-mcp.mjs && electron-vite build && electron-builder --win",
    "test:core": "esbuild tests/core.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-core.cjs && node tests/.build/test-core.cjs",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "dist:standalone": "node scripts/prepare-standalone.mjs && node scripts/prepare-mcp.mjs && electron-vite build && electron-builder --win",
    "test:mcp": "esbuild tests/mcp.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-mcp.cjs && node tests/.build/test-mcp.cjs",
    "test": "npm run test:core && npm run test:mcp && npm run test:ext && npm run test:storage && npm run test:safety && npm run test:files && npm run test:faults && npm run test:uierrors && npm run test:prompt && npm run test:actions && npm run test:appnames && npm run test:apikey",
    "prepare:mcp": "node scripts/prepare-mcp.mjs",
    "test:ext": "esbuild tests/extensions.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-ext.cjs && node tests/.build/test-ext.cjs",
    "test:storage": "esbuild tests/storage.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-storage.cjs && node tests/.build/test-storage.cjs",
    "test:safety": "esbuild tests/safety.test.ts --bundle --platform=node --format=cjs --external:jsdom --outfile=tests/.build/test-safety.cjs && node tests/.build/test-safety.cjs",
    "test:files": "esbuild tests/files.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-files.cjs && node tests/.build/test-files.cjs",
    "licenses": "node scripts/licenses.mjs",
    "test:faults": "esbuild tests/faults.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-faults.cjs && node tests/.build/test-faults.cjs",
    "test:uierrors": "esbuild tests/uierrors.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-uierrors.cjs && node tests/.build/test-uierrors.cjs",
    "test:prompt": "esbuild tests/prompt.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-prompt.cjs && node tests/.build/test-prompt.cjs",
    "test:actions": "esbuild tests/actions.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-actions.cjs && node tests/.build/test-actions.cjs",
    "test:appnames": "esbuild tests/appnames.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-appnames.cjs && node tests/.build/test-appnames.cjs",
    "test:apikey": "esbuild tests/apikey.test.ts --bundle --platform=node --format=cjs --alias:electron=./tests/electron-stub.js --outfile=tests/.build/test-apikey.cjs && node tests/.build/test-apikey.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "mammoth": "^1.12.0",
    "marked": "^12.0.2",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "telegram": "^2.26.22",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^0.436.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "app.kira.assistant",
    "productName": "Kira",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kira",
      "include": "build/installer.nsh"
    },
    "artifactName": "Kira-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026 VirusAid (D3F0LT). Все права защищены.",
    "publish": [
      {
        "provider": "github",
        "owner": "VirusAid",
        "repo": "Kira",
        "releaseType": "release"
      }
    ]
  }
}
