; Дополнение к установщику Kira.
;
; Единственная задача — спросить при удалении, что делать с личными данными.
;
; Почему это не решается настройкой deleteAppDataOnUninstall. Оба её значения
; плохи по-своему. Оставить всё молча — в профиле навсегда остаются гигабайты
; (офлайн-модель весит несколько), и человек не догадывается, где их искать.
; Стереть всё молча — вместе с Kira исчезают переписка, память о человеке,
; выученные команды и ключи, а он всего лишь хотел переустановить программу.
;
; Поэтому спрашиваем. По умолчанию — «оставить»: возвращаться к вопросу можно
; сколько угодно, а вернуть стёртое нельзя.

!macro customUnInstall
  ${ifNot} ${isUpdated}
    MessageBox MB_YESNO|MB_ICONQUESTION|MB_DEFBUTTON2 \
      "Удалить личные данные Kira?$\r$\n$\r$\n\
Это переписка, память о тебе, выученные команды, ключи и скачанный офлайн-разум \
(несколько гигабайт).$\r$\n$\r$\n\
Нет — данные останутся, и при повторной установке Kira продолжит с того же места." \
      IDYES deleteKiraData IDNO keepKiraData
    deleteKiraData:
      RMDir /r "$APPDATA\Kira"
      RMDir /r "$LOCALAPPDATA\kira-updater"
      Goto doneKiraData
    keepKiraData:
    doneKiraData:
  ${endIf}
!macroend
